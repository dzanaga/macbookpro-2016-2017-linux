# Omarchy 4 setup configuration for MacBookPro13,3.
RUN_MISC=0
RUN_WIFI=0
RUN_SOUND=0
RUN_TOUCHBAR_CAMERA=0
RUN_USBC_POWER=1
RUN_SUSPEND=1

PASSWORDLESS_SUDO=1
SUDOERS_MODE=full-user-nopasswd

WIFI_COUNTRY=BE
WIFI_TEMPLATE=../ubuntu-26.04/assets/wifi/brcmfmac43602-pcie.template.txt

# Touch Bar Fn mode:
#   0 = F1-F12 only
#   1 = special/media keys; hold Fn for F1-F12
#   2 = F1-F12; hold Fn for special/media keys
#   3 = special/media keys only
TOUCHBAR_FNMODE=1
# >0 is a timeout in seconds; -1 disables the timeout.
TOUCHBAR_IDLE_TIMEOUT=240
TOUCHBAR_DIM_TIMEOUT=300

USBC_POWER_DISABLE_D3COLD=1
USBC_POWER_KEEP_NHI=1
SUSPEND_MEMORY_SLEEP=s2idle

WORK_DIR=/var/lib/mbp13-linux-setup/omarchy-4
BACKUP_DIR=/var/backups/mbp13-linux-setup/omarchy-4
LOG_FILE=/var/log/mbp13-omarchy-setup.log
